# Provider: openai | anthropic | nvidia | fake
# `fake` runs the deterministic stand-in in backend/fake_llm.py - no key, no
# network beyond Open-Meteo. Useful for demos and the eval suite.
LLM_PROVIDER=nvidia

# --- NVIDIA NIM (OpenAI-compatible; free tier) ---
# Verify any model choice with `python -m backend.llm`: a free-tier key reaches only
# a subset of the models /v1/models lists, and retired ones answer 410 Gone.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_KEY=nvapi-...
# base URL is implied by LLM_PROVIDER=nvidia; override only if you need to:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# Per-LLM-call timeout in seconds. Free-tier endpoints queue.
LLM_TIMEOUT=120

# Set to 1 to force the weather client to fail (demo of the failure branch)
SIMULATE_WEATHER_DOWN=0
# Backend URL used by the Streamlit frontend
BACKEND_URL=http://127.0.0.1:8000
# Seconds the frontend waits for one turn (a turn is up to four LLM calls)
BACKEND_TIMEOUT=300
